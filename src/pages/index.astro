                <span>RxJava</span>
              </div>
            </div>

            <!-- 5. Dependency Injection -->
            <div class="tech-card reveal">
              <div class="tech-card-header">
                <span class="tech-dot"></span>
                <h3>Dependency Injection</h3>
              </div>
              <div class="tech-pills">
                <span>Hilt</span>
                <span>Dagger</span>
                <span>Koin</span>
              </div>
            </div>

            <!-- 6. Cross-Platform -->
            <div class="tech-card reveal">
              <div class="tech-card-header">
                <span class="tech-dot"></span>
                <h3>Cross-Platform</h3>
              </div>
              <div class="tech-pills">
                <span>Flutter</span>
                <span>Kotlin Multiplatform</span>
                <span>Compose Multiplatform</span>
              </div>
            </div>

            <!-- 7. Data, Networking & APIs -->
            <div class="tech-card reveal">
              <div class="tech-card-header">
                <span class="tech-dot"></span>
                <h3>Data, Networking &amp; APIs</h3>
              </div>
              <div class="tech-pills">
                <span>Room</span>
                <span>SQLDelight</span>
                <span>SQLite</span>
                <span>Firebase</span>
                <span>REST APIs</span>
                <span>WebSockets</span>
                <span>Retrofit</span>
                <span>Dio</span>
                <span>Ktor</span>
                <span>JSON Serializable</span>
                <span>ExoPlayer</span>
              </div>
            </div>

            <!-- 8. AI & Mobile ML -->
            <div class="tech-card reveal">
              <div class="tech-card-header">
                <span class="tech-dot"></span>
                <h3>AI &amp; Mobile ML</h3>
              </div>
              <div class="tech-pills">
                <span>Google Gemini API</span>
                <span>On-Device AI</span>
              </div>
            </div>

            <!-- 9. Tools & DevOps -->
            <div class="tech-card reveal">
              <div class="tech-card-header">
                <span class="tech-dot"></span>
                <h3>Tools &amp; DevOps</h3>
              </div>
              <div class="tech-pills">
                <span>Git</span>
                <span>GitHub Actions</span>
                <span>CI/CD</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="experience" id="experience">
        <div class="section-container">
          <div class="section-header reveal">
            <span class="section-label-badge">MY JOURNEY</span>
            <h2 class="section-title">
              Track Record of Delivering Production Scale
            </h2>
            <p class="section-subtitle">
              My professional journey building mobile applications, solving
              engineering challenges, and shipping high-quality software.
            </p>
          </div>

          <div class="experience-timeline">
            <!-- Item 1: Melvano -->
            <div class="exp-card reveal">
              <div class="exp-header">
                <div class="exp-title-block">
                  <span class="exp-period">NOV 2022 — MAY 2026</span>
                  <h3 class="exp-role">Senior Android Developer</h3>
                  <h4 class="exp-company">Melvano Education Pvt. Ltd.</h4>
                </div>
                <span class="exp-badge">Full-time</span>
              </div>

              <p class="exp-summary">
                Worked on an AI-powered learning platform for JEE and NEET
