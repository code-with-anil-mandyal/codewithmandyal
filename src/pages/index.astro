    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Navigation -->
    <header class="navbar" id="navbar">
      <div class="navbar-container">
        <a href="#home" class="logo">
          Code<span>With</span>Mandyal<span class="logo-dot"></span>
        </a>

        <button
          class="mobile-menu-toggle"
          id="mobile-menu-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="nav-menu"
          type="button"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>

        <div class="nav-wrapper" id="nav-menu">
          <nav class="nav-links">
            <a href="#home" class="active">Home</a>
            <a href="#about">About</a>
            <a href="#tech-stack">Tech Stack</a>
            <a href="#experience">Experience</a>
            <a href="#projects">Projects</a>
            <a href="#blog">Blog</a>
            <a href="#contact">Contact</a>
          </nav>
          <a href="#contact" class="nav-cta">Let's Talk <span>↗</span></a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="hero" id="home">
        <div class="hero-container">
          <div class="hero-content">
            <div class="status-badge hero-anim-1">
              <span class="status-dot"></span>
              Available for opportunities
            </div>

            <p class="hero-eyebrow hero-anim-2">
              Hi, I'm <span class="name-highlight">Anil Kumar.</span>
            </p>

            <h1 class="hero-title hero-anim-3">
              Senior Android &amp; Flutter Developer
            </h1>

            <p class="hero-tagline hero-anim-4">
              Building scalable mobile applications with <span
                class="highlight-text">clean code.</span
              >
            </p>

            <p class="hero-description hero-anim-5">
              With 6+ years of experience, I craft high-performance applications
              using Kotlin, Jetpack Compose, Flutter, and AI integration.
            </p>

            <div class="hero-actions hero-anim-6">
              <a href="#projects" class="btn-primary"
                >Explore My Work <span>↗</span></a
              >
              <a href="#contact" class="btn-secondary">Get in Touch</a>
              <a
                href="/resume.pdf"
                target="_blank"
                rel="noreferrer"
                class="btn-secondary">View Resume <span>↗</span></a
              >
            </div>

            <div class="hero-socials hero-anim-7">
              <a
                href="https://github.com/code-with-anil-mandyal"
                target="_blank"
                rel="noopener noreferrer">GitHub <span>↗</span></a
              >
              <span class="sep">·</span>
              <a
                href="https://www.linkedin.com/in/anil-mandyal"
                target="_blank"
                rel="noopener noreferrer">LinkedIn <span>↗</span></a
              >
              <span class="sep">·</span>
              <a href="mailto:anilani786@gmail.com">Email <span>↗</span></a>
            </div>
          </div>

          <div class="hero-visual hero-anim-card">
            <div class="glow-bg"></div>
            <div class="code-card">
              <div class="code-header">
                <div class="window-dots">
                  <span class="dot red"></span>
                  <span class="dot yellow"></span>
                  <span class="dot green"></span>
                </div>
                <span class="file-name">Developer.kt</span>
                <span class="file-icon">K</span>
              </div>

              <div class="code-body">
                <p>
                  <span class="line">01</span>
                  <span class="purple">class</span>
                  <span class="yellow">Developer</span> &#123;
                </p>
                <p>
                  <span class="line">02</span> &nbsp; <span class="purple"
                    >val</span
                  > name = <span class="green">"Anil Kumar"</span>
                </p>
                <p>
                  <span class="line">03</span> &nbsp; <span class="purple"
                    >val</span
                  > role = <span class="green"
                    >"Senior Android &amp; Flutter Developer"</span
                  >
                </p>
                <p>
                  <span class="line">04</span> &nbsp; <span class="purple"
                    >val</span
                  > experience = <span class="green">"6+ Years"</span>
                </p>
                <p>
                  <span class="line">05</span> &nbsp; <span class="purple"
                    >val</span
                  > focus = <span class="green"
                    >"Android, Flutter &amp; Architecture"</span
                  >
                </p>
                <p><span class="line">06</span></p>
                <p>
                  <span class="line">07</span> &nbsp; <span class="purple"
                    >fun</span
                  >
                  <span class="blue">buildScalableApps</span>() &#123;
                </p>
                <p>
                  <span class="line">08</span> &nbsp; &nbsp; <span
                    class="comment">// Turning ideas into reality</span
                  >
                </p>
                <p>
                  <span class="line">09</span> &nbsp; &nbsp; createProductionCode()
                </p>
                <p><span class="line">10</span> &nbsp; &#125;</p>
                <p><span class="line">11</span> &#125;</p>
                <div class="cursor"></div>
              </div>

              <div class="code-footer">
                <span class="footer-status"
                  ><span class="status-dot"></span> Kotlin</span
                >
                <span class="footer-meta">UTF-8 &nbsp;·&nbsp; LF</span>
              </div>
            </div>

            <div class="floating-chip chip-top">
              <span class="chip-icon">✳</span>
              <span>Jetpack Compose</span>
            </div>
            <div class="floating-chip chip-bottom">
              <span class="chip-icon purple-text">⌘</span>
              <span>Kotlin Multiplatform</span>
            </div>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section class="about" id="about">
        <div class="section-container">
          <div class="section-header reveal">
            <span class="section-label-badge">ABOUT ME</span>
            <h2 class="section-title">
              Engineering Android &amp; Cross-Platform Mobile Experiences
            </h2>
          </div>

          <div class="about-grid">
            <div class="about-editorial reveal">
              <p>
                Hi, I'm Anil Kumar, a Senior Android &amp; Flutter Developer
                with 6+ years of experience designing, building, and scaling
                production-grade mobile applications.
              </p>

              <p>
                My core expertise lies in Kotlin, Jetpack Compose, Clean
                Architecture, and MVVM. I have built Android apps from scratch,
                maintained and evolved live production apps, improved
                performance on low-end devices, and contributed to products with
                100K+ downloads.
              </p>

              <p>
                Alongside native Android, I have hands-on experience with
                Flutter and Dart, Kotlin Multiplatform, and Compose
                Multiplatform. I'm also passionate about AI integration,
                including building features with the Google Gemini API and
                exploring on-device AI.
              </p>

              <p>
                I've worked across ed-tech, payments, and content-streaming
                domains, collaborating closely with cross-functional teams to
                deliver reliable, scalable, and user-friendly products.
              </p>

              <div class="about-actions">
                <a
                  href="/resume.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary">View Resume <span>↗</span></a
                >
              </div>
            </div>

            <div class="about-stats-grid">
              <div class="stat-card reveal">
                <div class="stat-number">6+</div>
                <div class="stat-label">Years Experience</div>
              </div>
              <div class="stat-card reveal">
                <div class="stat-number">100K+</div>
                <div class="stat-label">App Downloads</div>
              </div>
              <div class="stat-card reveal">
                <div class="stat-number">10K+</div>
                <div class="stat-label">Active Installs</div>
              </div>
              <div class="stat-card stat-card-highlight reveal">
                <div class="stat-number text-accent">Android + Flutter</div>
                <div class="stat-label">Cross-Platform Development</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Tech Stack & Architecture -->
