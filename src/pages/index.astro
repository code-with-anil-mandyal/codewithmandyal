/* Professional Experience */
.experience {
  padding: 100px 24px;
  background: #0a0a0d;
}

.experience-container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.experience-heading {
  max-width: 700px;
  margin-bottom: 56px;
}

.experience-heading h2 {
  margin: 0 0 16px;
  color: #f4f4f5;
  font-size: clamp(34px, 5vw, 48px);
  line-height: 1.15;
  letter-spacing: -1.5px;
}

.experience-heading h2 span {
  color: #a78bfa;
}

.experience-heading > p {
  margin: 0;
  color: #a1a1aa;
  font-size: 15px;
  line-height: 1.8;
}

.experience-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.experience-list::before {
  content: "";
  position: absolute;
  top: 20px;
  bottom: 20px;
  left: 9px;
  width: 1px;
  background: #35303f;
}

.experience-card {
  position: relative;
  display: grid;
  grid-template-columns: 20px minmax(0, 1fr);
  gap: 24px;
}

.experience-marker {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  padding-top: 30px;
}

.experience-marker span {
  width: 19px;
  height: 19px;
  border: 4px solid #0a0a0d;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 0 0 1px #a78bfa;
}

.experience-content {
  min-width: 0;
  padding: 30px;
  border: 1px solid #262630;
  border-radius: 16px;
  background: #111116;
  transition: border-color 0.25s ease,
    transform 0.25s ease;
}

.experience-content:hover {
  transform: translateY(-3px);
  border-color: #8b72d8;
}

.experience-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.experience-period {
  display: inline-block;
  margin-bottom: 12px;
  color: #a78bfa;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.experience-top h3 {
  margin: 0 0 6px;
  color: #f4f4f5;
  font-size: 22px;
  line-height: 1.4;
}

.experience-top h4 {
  margin: 0;
  color: #c4c4ce;
  font-size: 15px;
  font-weight: 500;
}

.experience-type {
  flex-shrink: 0;
  padding: 7px 11px;
  border: 1px solid #35303f;
  border-radius: 7px;
  background: #1b1727;
  color: #c4b5fd;
  font-size: 11px;
  font-weight: 600;
}

.experience-summary {
  margin: 0 0 20px;
  color: #a1a1aa;
  font-size: 14px;
  line-height: 1.8;
}

.experience-points {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0 0 24px;
  padding-left: 20px;
  color: #b5b5c0;
  font-size: 14px;
  line-height: 1.75;
}

.experience-points li {
  padding-left: 4px;
}

.experience-points li::marker {
  color: #a78bfa;
}

.experience-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding-top: 20px;
  border-top: 1px solid #292933;
}

.experience-tags span {
  padding: 7px 11px;
  border: 1px solid #2b2b35;
  border-radius: 6px;
  background: #17171e;
  color: #c4c4ce;
  font-size: 11px;
}

/* Tablet */
@media (max-width: 700px) {
  .experience {
    padding: 80px 24px;
  }

  .experience-content {
    padding: 24px;
  }

  .experience-top {
    flex-wrap: wrap;
  }
}

/* Mobile */
@media (max-width: 500px) {
  .experience {
    padding: 64px 20px;
  }

  .experience-heading {
    margin-bottom: 36px;
  }

  .experience-heading h2 {
    font-size: 34px;
    letter-spacing: -1px;
  }

  .experience-heading > p {
    font-size: 14px;
  }

  .experience-list {
    gap: 20px;
  }

  .experience-card {
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 14px;
  }

  .experience-list::before {
    left: 6px;
  }

  .experience-marker {
    padding-top: 26px;
  }

  .experience-marker span {
    width: 14px;
    height: 14px;
    border-width: 3px;
  }

  .experience-content {
    padding: 20px;
  }

  .experience-top h3 {
    font-size: 19px;
  }

  .experience-top h4 {
    font-size: 14px;
  }

  .experience-type {
    font-size: 10px;
  }

  .experience-summary,
  .experience-points {
    font-size: 13px;
  }

  .experience-points {
    padding-left: 17px;
  }

  .experience-tags {
    gap: 7px;
  }

  .experience-tags span {
    padding: 6px 9px;
    font-size: 10px;
  }
}


