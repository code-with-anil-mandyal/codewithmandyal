  gap: 18px;
}

.contact-detail {
  display: flex;
  align-items: center;
  gap: 15px;
  min-width: 0;
  padding: 18px;
  border: 1px solid #292933;
  border-radius: 12px;
  background: #15151b;
}

.contact-detail-icon {
