    background: var(--accent-green);
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.8);
  }

  .hero-eyebrow {
    font-size: clamp(16px, 2.5vw, 18px);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .name-highlight {
    color: var(--accent-purple-light);
    font-weight: 700;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.5vw, 54px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--text-primary);
    margin-bottom: 20px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .hero-tagline {
    font-size: clamp(18px, 2.5vw, 26px);
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
    overflow-wrap: break-word;
  }

  .highlight-text {
    color: var(--accent-purple);
  }

  .hero-description {
    max-width: 520px;
    font-size: clamp(14px, 1.8vw, 15px);
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 36px;
  }

  .hero-socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero-socials a {
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .hero-socials a span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .hero-socials a:hover {
      color: var(--accent-purple-light);
    }

    .hero-socials a:hover span {
      transform: translate(2px, -2px);
    }
  }

  .sep {
    color: var(--text-muted);
  }

  /* Hero Code Visual */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .glow-bg {
    position: absolute;
    width: 320px;
    height: 320px;
    background: radial-gradient(
      circle,
      rgba(167, 139, 250, 0.15) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    filter: blur(40px);
    border-radius: 50%;
  }

  @keyframes gentleFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .code-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    animation: gentleFloat 6s ease-in-out infinite;
  }

  .code-header {
    height: 42px;
    padding: 0 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .window-dots .red {
    background: #ef4444;
  }
  .window-dots .yellow {
    background: #f59e0b;
  }
  .window-dots .green {
    background: #10b981;
  }

  .file-name {
    font-family: monospace;
    font-size: 11px;
    color: var(--text-secondary);
  }

  .file-icon {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-purple);
  }

  .code-body {
    padding: 20px 16px;
    font-family: monospace;
    font-size: 11px;
    line-height: 2;
    color: var(--text-primary);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .code-body p {
    white-space: pre;
  }

  .line {
    display: inline-block;
    width: 24px;
    color: var(--text-muted);
    user-select: none;
  }

  .purple {
    color: var(--accent-purple-light);
  }
  .yellow {
    color: #fcd34d;
  }
  .green {
    color: #86efac;
  }
  .blue {
    color: #93c5fd;
  }
  .comment {
    color: var(--text-muted);
    font-style: italic;
  }

  .cursor {
    width: 6px;
    height: 14px;
    background: var(--accent-purple-light);
    margin-left: 42px;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .code-footer {
    height: 38px;
    padding: 0 16px;
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-muted);
  }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .floating-chip {
    position: absolute;
    z-index: 2;
    background: #181820;
    border: 1px solid var(--border-subtle);
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 11px;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .chip-top {
    top: 20px;
    right: -10px;
  }

  .chip-bottom {
    bottom: 20px;
    left: -10px;
  }

  .chip-icon {
    color: var(--accent-purple);
  }

  /* Scroll Reveal System */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* About Section */
  .about {
    padding: 100px 0;
    background: var(--bg-section-alt);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 56px;
    align-items: start;
  }

  .about-editorial p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .about-actions {
    margin-top: 28px;
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 24px 20px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  @media (hover: hover) {
    .stat-card:hover {
      transform: translateY(-3px);
      border-color: rgba(167, 139, 250, 0.4);
      box-shadow: 0 8px 24px rgba(167, 139, 250, 0.12);
    }
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.5vw, 32px);
    font-weight: 700;
    color: var(--accent-purple-light);
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .stat-card-highlight .stat-number {
    font-size: clamp(17px, 2.2vw, 20px);
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Tech Stack */
  .tech-stack {
    padding: 100px 0;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .tech-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 24px;
    border-radius: 12px;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  @media (hover: hover) {
    .tech-card:hover {
      transform: translateY(-3px);
      border-color: rgba(167, 139, 250, 0.35);
      box-shadow: 0 8px 24px rgba(167, 139, 250, 0.1);
    }
  }

  .tech-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .tech-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-purple);
    flex-shrink: 0;
  }

  .tech-card-header h3 {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-pills span {
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 12px;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  @media (hover: hover) {
    .tech-pills span:hover {
      transform: translateY(-1px);
      background: var(--accent-purple-bg);
      border-color: var(--border-accent);
      color: var(--accent-purple-light);
    }
  }

  /* Professional Experience */
  .experience {
    padding: 100px 0;
    background: var(--bg-section-alt);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .exp-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 32px;
    border-radius: 14px;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  @media (hover: hover) {
    .exp-card:hover {
      transform: translateY(-4px);
      border-color: rgba(167, 139, 250, 0.35);
      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.4),
        0 0 20px rgba(167, 139, 250, 0.08);
    }
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .exp-period {
    display: inline-block;
    color: var(--accent-purple);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
  }

  .exp-role {
    font-family: var(--font-heading);
    font-size: clamp(19px, 2.5vw, 22px);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .exp-company {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .exp-badge {
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.2);
    color: var(--accent-green);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .exp-summary {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .exp-bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 20px;
    margin-bottom: 24px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.7;
  }

  .exp-bullets li::marker {
    color: var(--accent-purple);
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }

  .exp-tags span {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 11px;
  }

  /* Featured Projects */
  .projects {
    padding: 100px 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  .project-banner {
    position: relative;
    width: 100%;
    height: 220px;
    background: #16161d;
    overflow: hidden;
  }

  .project-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-number-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(9, 9, 11, 0.85);
    border: 1px solid var(--border-subtle);
    color: var(--accent-purple-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    backdrop-filter: blur(6px);
  }

  .project-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .project-subtitle {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-purple);
    margin-bottom: 12px;
  }

  .project-desc {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 20px;
    flex: 1;
  }

  .project-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .project-pills span {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 11px;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .project-link span {
    color: var(--accent-purple);
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(167, 139, 250, 0.4);
      box-shadow:
        0 14px 38px rgba(0, 0, 0, 0.5),
        0 0 24px rgba(167, 139, 250, 0.1);
    }

    .project-card:hover .project-banner img {
      transform: scale(1.03);
    }

    .project-card:hover .project-link {
      color: var(--accent-purple-light);
    }

    .project-card:hover .project-link span {
      transform: translateX(4px);
    }
  }

  /* Blog Section */
  .blog {
    padding: 100px 0;
    background: var(--bg-section-alt);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .blog-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 24px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  .blog-cat {
    display: inline-block;
    color: var(--accent-purple);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .blog-title a {
    transition: color 0.2s ease;
  }

  .blog-desc {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .blog-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-purple-light);
    font-size: 12px;
    font-weight: 600;
  }

  .blog-cta span {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .blog-card:hover {
      transform: translateY(-3px);
      border-color: rgba(167, 139, 250, 0.35);
      box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.4),
        0 0 15px rgba(167, 139, 250, 0.08);
    }

    .blog-card:hover .blog-title a {
      color: var(--accent-purple-light);
    }

    .blog-card:hover .blog-cta span {
      transform: translate(3px, -3px);
    }
  }

  .medium-card {
    background: radial-gradient(
      circle at 10% 10%,
      rgba(167, 139, 250, 0.12) 0%,
      rgba(18, 18, 23, 1) 70%
    );
  }

  .medium-badge {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-purple-bg);
    border: 1px solid var(--border-accent);
    color: var(--accent-purple-light);
    font-family: Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  /* Contact Section */
  .contact {
    padding: 100px 0;
  }

  .contact-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 16px;
    overflow-wrap: break-word;
  }

  .contact-desc {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .copy-btn {
    cursor: pointer;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    padding: 20px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
  }

  .contact-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--accent-purple-bg);
    border: 1px solid var(--border-accent);
    color: var(--accent-purple-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .contact-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .contact-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .contact-arrow {
    color: var(--accent-purple);
    font-size: 16px;
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .contact-card:hover {
