                <span>MVVM</span>
                <span>Retrofit</span>
                <span>Firebase</span>
                <span>Google Maps</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Featured Projects -->
      <section class="projects" id="projects">
        <div class="section-container">
          <div class="section-header reveal">
            <span class="section-label-badge">MY WORK</span>
            <h2 class="section-title">
