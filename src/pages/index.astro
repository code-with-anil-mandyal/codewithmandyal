---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />

    <!-- SEO -->
    <link rel="icon" type="image/png" href="/cm-logo.png" />
    <title>Anil Kumar – Senior Android &amp; Flutter Developer</title>
    <meta
      name="description"
      content="Anil Kumar is a Senior Android & Flutter Developer with 6+ years of experience in Kotlin, Jetpack Compose, Flutter, Dart, and Kotlin Multiplatform."
    />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Anil Kumar – Senior Android & Flutter Developer"
    />
    <meta
      property="og:description"
      content="Explore Anil Kumar's projects, professional experience, and expertise in Kotlin, Jetpack Compose, and mobile engineering."
    />
    <meta property="og:url" content="https://codewithmandyal.com/" />
    <meta
      property="og:image"
      content="https://codewithmandyal.com/og-image.png"
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Anil Kumar – Senior Android & Flutter Developer"
    />
    <meta
      name="twitter:description"
      content="Senior Android & Flutter Developer specializing in Kotlin, Jetpack Compose, Flutter, Dart, and Kotlin Multiplatform."
    />
    <meta
      name="twitter:image"
      content="https://codewithmandyal.com/og-image.png"
    />

    <!-- Fonts -->
