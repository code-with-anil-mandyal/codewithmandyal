  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
}

.contact-detail a:hover {
  color: #a78bfa;
}

.contact-detail-arrow {
  color: #a78bfa;
  font-size: 17px;
}

.contact-availability {
