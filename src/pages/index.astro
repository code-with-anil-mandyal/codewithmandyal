  border-radius: 10px;
  background: #a78bfa;
  color: #171126 !important;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  opacity: 1;
  visibility: visible;
  transition: transform 0.2s ease, background 0.2s ease;
}

.contact-button span {
  color: #171126 !important;
  opacity: 1;
  visibility: visible;
}

.contact-button:hover {
